FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install base dependencies the userdata script assumes exist
RUN apt-get update -qq && \
    apt-get install -y -qq sudo && \
    apt-get clean

# Create ubuntu user (exists on EC2 AMIs)
RUN useradd -m -s /bin/bash ubuntu

# Create log directory
RUN mkdir -p /var/log

COPY userdata-redteam.sh /usr/local/bin/userdata.sh
RUN chmod +x /usr/local/bin/userdata.sh

CMD ["/usr/local/bin/userdata.sh"]
