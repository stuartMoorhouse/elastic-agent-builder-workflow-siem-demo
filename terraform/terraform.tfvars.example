# Deployment Configuration
deployment_name        = "workflow-demo"
region                 = "gcp-us-central1"
deployment_template_id = "gcp-storage-optimized"

# Elasticsearch Configuration
elasticsearch_size       = "8g"
elasticsearch_zone_count = 1

# Kibana Configuration
kibana_size       = "1g"
kibana_zone_count = 1

# AWS Configuration
aws_region = "eu-north-1"
aws_tags = {
  division   = "your-division"
  org        = "your-org"
  keep-until = "2026-12-31"
  team       = "your-team"
  project    = "your-project"
}

# AWS Instance Types
aws_instance_type_host    = "t3.large"
aws_instance_type_redteam = "t3.large"

# AWS Networking
vpc_cidr           = "10.0.0.0/16"
public_subnet_cidr = "10.0.1.0/24"
allowed_ssh_cidr   = "YOUR_IP/32"  # Replace with your public IP